{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "noEmitOnError": true,

    "sourceMap": true,
    "inlineSources": true,

    "types": ["chrome"],

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
