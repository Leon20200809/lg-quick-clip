{
  "manifest_version": 3,
  "name": "LG Quick Clip",
  "version": "0.1.0",
  "description": "カテゴリ別の定型文を素早く呼び出してフォームへ入力するChrome拡張機能。",
  "key": "",

  "permissions": ["storage", "sidePanel"],

  "action": {
    "default_title": "LG Quick Clip を開く"
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"]
    }
  ]
}
